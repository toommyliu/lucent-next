{
  "name": "wisp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "cargo run -p lucent-app --bin lucent",
    "start": "cargo run -p lucent-app --bin lucent --release",
    "generate:protocol": "cargo run -p lucent-protocol --bin export-types",
    "check:protocol": "cargo run -p lucent-protocol --bin export-types -- --check",
    "check:scripting-api": "pnpm --filter @lucent/scripting-api check",
    "as3": "pnpm run as3:bridge && pnpm run as3:build",
    "as3:bridge": "tsx scripts/gen-as3-bridge.ts",
    "as3:build": "tsx scripts/build-as3-swf.ts",
    "bump:ruffle": "tsx scripts/bump-ruffle.ts",
    "typecheck": "pnpm typecheck:scripts && pnpm -r typecheck && pnpm typecheck:script-packages",
    "typecheck:scripts": "tsc6 -p scripts/tsconfig.json --noEmit",
    "typecheck:script-packages": "tsc6 -p script-packages/lucent-consumables/jsconfig.repo.json --noEmit && tsc6 -p script-packages/lucent-dailies/jsconfig.repo.json --noEmit",
    "test": "pnpm test:scripts && pnpm -r test",
    "test:scripts": "tsx --test scripts/*.test.ts",
    "vendor:zed": "tsx scripts/vendor-zed.ts",
    "bundle:runtime": "pnpm --filter @lucent/runtime bundle",
    "check:runtime-bundle": "pnpm --filter @lucent/runtime check:bundle",
    "measure:runtime": "cargo test --release -p lucent-runtime --test workload -- --ignored --nocapture"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.3",
    "@types/node": "^24.12.2",
    "asconfigc": "^1.9.0",
    "effect": "4.0.3",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
